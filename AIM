--============================================================
-- CLASSIFY
--============================================================
local function getHitboxFolder(m) return m:FindFirstChild("Hitbox_Bots") or m:FindFirstChild("Hitbox") end
local function isBot(m) return getHitboxFolder(m) ~= nil end
local function isPlayer(m) return Players:GetPlayerFromCharacter(m) ~= nil end
local function classify(m)
    if isPlayer(m) then return "Player" end
    if isBot(m) then return "Bot" end
    return nil
end
local function passes(kind, filter)
    if filter == "Both" then return kind ~= nil end
    return kind == filter
end
local function getHealth(m)
    local h = m:FindFirstChildOfClass("Humanoid")
    if h then return h.Health, h.MaxHealth end
    return 100, 100
end

--============================================================
-- ESP LOGIC
--============================================================
local espObjects = {}

local function removeESP(m)
    local d = espObjects[m]
    if not d then return end
    for _, o in pairs(d) do if o.Remove then o:Remove() end end
    espObjects[m] = nil
end

local function createESP(m)
    local d = {}
    if State.ESP_Box then d.box = Drawing.new("Square"); d.box.Thickness=1; d.box.Filled=false end
    if State.ESP_Name then d.name = Drawing.new("Text"); d.name.Size=14; d.name.Center=true; d.name.Outline=true; d.name.OutlineColor=Color3.new(0,0,0) end
    if State.ESP_Distance then d.dist = Drawing.new("Text"); d.dist.Size=13; d.dist.Center=true; d.dist.Outline=true; d.dist.OutlineColor=Color3.new(0,0,0) end
    if State.ESP_Health then
        d.hbg = Drawing.new("Square"); d.hbg.Filled=true; d.hbg.Color=Color3.fromRGB(20,20,20)
        d.hbar = Drawing.new("Square"); d.hbar.Filled=true
    end
    if State.ESP_HeadDot then d.dot = Drawing.new("Circle"); d.dot.Radius=4; d.dot.Filled=true end
    espObjects[m] = d
end

local function setVis(d, v) for _, o in pairs(d) do o.Visible = v end end

local function updateESP()
    local camPos = Camera.CFrame.Position
    for m, d in pairs(espObjects) do
        local kind = classify(m)
        if not kind or not m.Parent or not passes(kind, State.ESP_Filter) then
            setVis(d, false)
        else
            local hf = getHitboxFolder(m)
            local head = hf and hf:FindFirstChild("Hitbox_Head") or m:FindFirstChild("Head")
            local root = hf and hf:FindFirstChild("Hitbox_Torso") or m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
            if not head or not root then setVis(d, false) else
                local hp, hon = Camera:WorldToViewportPoint(head.Position)
                local rp, ron = Camera:WorldToViewportPoint(root.Position)
                local dist = (camPos - root.Position).Magnitude
                if not hon or not ron or dist > 2000 then
                    setVis(d, false)
                else
                    setVis(d, true)
                    local col = (kind == "Player") and C.PlyCol or C.BotCol
                    if d.box then
                        local h = math.abs(hp.Y - rp.Y) * 2.2
                        local w = h * 0.6
                        d.box.Size = Vector2.new(w, h)
                        d.box.Position = Vector2.new(hp.X - w/2, hp.Y - h*0.15)
                        d.box.Color = col
                    end
                    if d.name then d.name.Text = m.Name; d.name.Position = Vector2.new(hp.X, hp.Y - 22); d.name.Color = col end
                    if d.dist then d.dist.Text = string.format("[%d]", math.floor(dist)); d.dist.Position = Vector2.new(hp.X, hp.Y + 4); d.dist.Color = col end
                    if d.hbar and d.box then
                        local h, mh = getHealth(m)
                        local pct = math.clamp(h/mh, 0, 1)
                        local bx, by, bh = d.box.Position.X - 6, d.box.Position.Y, d.box.Size.Y
                        d.hbg.Size = Vector2.new(3, bh); d.hbg.Position = Vector2.new(bx, by)
                        d.hbar.Size = Vector2.new(3, bh*pct); d.hbar.Position = Vector2.new(bx, by + bh*(1-pct))
                        d.hbar.Color = Color3.fromRGB(255*(1-pct), 255*pct, 0)
                    end
                    if d.dot then d.dot.Position = Vector2.new(hp.X, hp.Y); d.dot.Color = col end
                end
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.5) do
        for m in pairs(espObjects) do if not m.Parent then removeESP(m) end end
        if State.ESP_Enabled then
            for _, o in ipairs(Workspace:GetChildren()) do
                if o:IsA("Model") and o ~= LocalPlayer.Character and not espObjects[o] then
                    local k = classify(o)
                    if k and passes(k, State.ESP_Filter) then createESP(o) end
                end
            end
        else
            for m in pairs(espObjects) do removeESP(m) end
        end
    end
end)

--============================================================
-- AIMBOT LOGIC
--============================================================
local function getTargetPart(m)
    local hf = getHitboxFolder(m)
    if hf then
        if State.Aimbot_Part == "Torso" then
            return hf:FindFirstChild("Hitbox_Torso") or hf:FindFirstChild("Hitbox_Head")
        else
            return hf:FindFirstChild("Hitbox_Head") or hf:FindFirstChild("Hitbox_Torso")
        end
    end
    return m:FindFirstChild("Head")
end

local function getClosest()
    local camPos = Camera.CFrame.Position
    local vp = Camera.ViewportSize / 2
    local best, bestD = nil, State.Aimbot_FOV
    for m in pairs(espObjects) do
        if m.Parent then
            local k = classify(m)
            if k and passes(k, State.Aimbot_Filter) then
                local p = getTargetPart(m)
                if p then
                    local sp, on = Camera:WorldToViewportPoint(p.Position)
                    if on then
                        local d = math.sqrt((sp.X-vp.X)^2 + (sp.Y-vp.Y)^2)
                        if d < bestD then
                            local vis = true
                            if State.Aimbot_Visible then
                                local rp = RaycastParams.new()
                                rp.FilterType = Enum.RaycastFilterType.Exclude
                                rp.FilterDescendantsInstances = {LocalPlayer.Character, m}
                                vis = Workspace:Raycast(camPos, p.Position - camPos, rp) == nil
                            end
                            if vis then best, bestD = p, d end
                        end
                    end
                end
            end
        end
    end
    return best
end

