-- ============================================
-- 🔍 Logic Aimlock
-- ============================================
local lockedTarget = nil
local isLocking    = false
local currentSize  = CONFIG.CIRCLE_SIZE

local function isEnemy(plr)
    if not plr or plr == LocalPlayer then return false end
    if not plr.Character then return false end
    if not plr.Character:FindFirstChild("HumanoidRootPart") then return false end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if CONFIG.TEAM_CHECK and plr.Team and LocalPlayer.Team
       and plr.Team == LocalPlayer.Team then
        return false
    end
    return true
end

local function findTarget()
    local camPos = Camera.CFrame.Position
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)

    local best, bestScore = nil, math.huge
    local fovRadius = (viewport.Y / 2) * math.tan(math.rad(CONFIG.FOV / 2))

    for _, plr in ipairs(Players:GetPlayers()) do
        if not isEnemy(plr) then continue end
        local hrp = plr.Character.HumanoidRootPart
        local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if onScreen and screenPos.Z > 0 then
            local dist3D = (hrp.Position - camPos).Magnitude
            if dist3D > CONFIG.MAX_DISTANCE then continue end
            local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
            if screenDist <= fovRadius and screenDist < bestScore then
                bestScore = screenDist
                best = plr
            end
        end
    end
    return best
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if LOCK_KEYS[input.KeyCode] or LOCK_KEYS[input.UserInputType] then
        isLocking = true
        lockedTarget = findTarget()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if LOCK_KEYS[input.KeyCode] or LOCK_KEYS[input.UserInputType] then
        local stillHeld = false
        for key, _ in pairs(LOCK_KEYS) do
            if typeof(key) == "EnumItem" and key.EnumType == Enum.KeyCode then
                if UserInputService:IsKeyDown(key) then stillHeld = true break end
            end
        end
        if not stillHeld then
            isLocking = false
            lockedTarget = nil
        end
    end
end)

local function updateCircle(target)
    if not circle then return end
    if not target then
        circle.Visible = false
        if dot then dot.Visible = false end
        return
    end
    local hrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        circle.Visible = false
        if dot then dot.Visible = false end
        return
    end
    local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
    if not onScreen or screenPos.Z <= 0 then
        circle.Visible = false
        if dot then dot.Visible = false end
        return
    end

    local targetSize = CONFIG.CIRCLE_SIZE
    if CONFIG.SCALE_MODE == "distance" then
        local dist = (hrp.Position - Camera.CFrame.Position).Magnitude
        targetSize = CONFIG.CIRCLE_SIZE + (dist / CONFIG.MAX_DISTANCE) * CONFIG.SCALE_SPEED
    elseif CONFIG.SCALE_MODE == "fov" then
        targetSize = (Camera.ViewportSize.Y / 2) * math.tan(math.rad(CONFIG.FOV / 2)) * 0.15
    end
    currentSize = currentSize + (targetSize - currentSize) * 0.2

    circle.Position = Vector2.new(screenPos.X, screenPos.Y)
    circle.Radius   = currentSize
    circle.Visible  = true
    if dot then
        dot.Position = Vector2.new(screenPos.X, screenPos.Y)
        dot.Visible  = true
    end
end

local function aimAt(target)
    if not target then return end
    local hrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local camCF = Camera.CFrame
    local lookAt = CFrame.new(camCF.Position, hrp.Position)
    Camera.CFrame = camCF:Lerp(lookAt, 1 - CONFIG.SMOOTHNESS)
end

RunService.RenderStepped:Connect(function()
    if not CONFIG.Enabled then
        if circle then circle.Visible = false end
        if dot then dot.Visible = false end
        return
    end

    if isLocking then
        if not lockedTarget
           or not lockedTarget.Character
           or not isEnemy(lockedTarget) then
            lockedTarget = findTarget()
        end
        if lockedTarget then aimAt(lockedTarget) end
    else
        lockedTarget = nil
    end

    updateCircle(lockedTarget)
end)

