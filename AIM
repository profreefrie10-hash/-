-- ====== เปิด/ปิดเมนู ======
local menuOpen = false
local function setMenu(open)
    menuOpen = open
    if open then
        mainFrame.Visible = true
        mainFrame.Size = UDim2.fromOffset(0, 0)
        TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Back), {
            Size = UDim2.fromOffset(260, 400)
        }):Play()
    else
        local tw = TweenService:Create(mainFrame, TweenInfo.new(0.2), {
            Size = UDim2.fromOffset(0, 0)
        })
        tw:Play()
        tw.Completed:Connect(function()
            if not menuOpen then mainFrame.Visible = false end
        end)
    end
end

toggleBtn.MouseButton1Click:Connect(function() setMenu(not menuOpen) end)
closeBtn.MouseButton1Click:Connect(function() setMenu(false) end)

-- ============================================
-- 🔄 อัปเดต FOV Circle ขนาดตาม FOV
-- ============================================
local function updateFOVCircle()
    local vp = Camera.ViewportSize
    -- คำนวณรัศมีวง FOV เป็น pixel
    local radius = (vp.Y / 2) * math.tan(math.rad(math.min(CONFIG.FOV, 179) / 2))
    if CONFIG.FOV >= 180 then
        radius = vp.Y / 2  -- กว้างสุดจอ
    end
    fovCircle.Size = UDim2.fromOffset(radius * 2, radius * 2)
    fovStroke.Color = CONFIG.CIRCLE_COLOR
end
updateFOVCircle()

-- ============================================
-- 🔍 ตรรกะ Aimlock
-- ============================================
local lockedTarget = nil
local isLocking = false
local currentSize = CONFIG.CIRCLE_SIZE

local function isEnemy(plr)
    if not plr or plr == LocalPlayer then return false end
    if not plr.Character then return false end
    if not getTargetPart(plr.Character) then return false end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if CONFIG.TEAM_CHECK and plr.Team and LocalPlayer.Team
       and plr.Team == LocalPlayer.Team then
        return false
    end
    return true
end

local function findTarget()
    local camPos = Camera.CFrame.Position
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
    local best, bestScore = nil, math.huge
    local fovRadius = math.huge
    if CONFIG.FOV < 180 then
        fovRadius = (viewport.Y / 2) * math.tan(math.rad(CONFIG.FOV / 2))
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if not isEnemy(plr) then continue end
        local part = getTargetPart(plr.Character)
        if not part then continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if onScreen and screenPos.Z > 0 then
            local dist3D = (part.Position - camPos).Magnitude
            if dist3D > CONFIG.MAX_DISTANCE then continue end
            local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
            if screenDist <= fovRadius and screenDist < bestScore then
                bestScore = screenDist
                best = plr
            end
        end
    end
    return best
end

-- ====== ตรวจจับปุ่ม ======
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if LOCK_KEYS[input.KeyCode] or LOCK_KEYS[input.UserInputType] then
        isLocking = true
        lockedTarget = findTarget()
        print("[Aimlock] ล็อค:", lockedTarget and lockedTarget.Name or "ไม่เจอเป้า")
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if LOCK_KEYS[input.KeyCode] or LOCK_KEYS[input.UserInputType] then
        local stillHeld = false
        for key, _ in pairs(LOCK_KEYS) do
            if typeof(key) == "EnumItem" and key.EnumType == Enum.KeyCode then
                if UserInputService:IsKeyDown(key) then stillHeld = true break end
            end
        end
        if not stillHeld then
            isLocking = false
            lockedTarget = nil
        end
    end
end)

-- ====== อัปเดตวงล็อคเป้า ======
local function updateLockCircle(target)
    if not target then
        lockCircle.Visible = false
        lockDot.Visible = false
        return
    end
    local part = getTargetPart(target.Character)
    if not part then
        lockCircle.Visible = false
        lockDot.Visible = false
        return
    end
    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
    if not onScreen or screenPos.Z <= 0 then
        lockCircle.Visible = false
        lockDot.Visible = false
        return
    end
    lockCircle.Position = UDim2.fromOffset(screenPos.X, screenPos.Y)
    lockCircle.Size = UDim2.fromOffset(currentSize * 2, currentSize * 2)
    lockCircle.Visible = true
    lockDot.Visible = true
end

-- ====== Aim ======
local function aimAt(target)
    if not target or CONFIG.SILENT_AIM then return end
    local part = getTargetPart(target.Character)
    if not part then return end
    local camCF = Camera.CFrame
    local lookAt = CFrame.new(camCF.Position, part.Position)
    Camera.CFrame = camCF:Lerp(lookAt, 1 - CONFIG.SMOOTHNESS)
end

-- ============================================
-- 🔄 Render Loop
-- ============================================
RunService.RenderStepped:Connect(function()
    if not CONFIG.Enabled then
        lockCircle.Visible = false
        lockDot.Visible = false
        return
    end

    -- อัปเดต FOV circle ตาม viewport
    updateFOVCircle()

    if isLocking then
        if not lockedTarget or not lockedTarget.Character 
           or not isEnemy(lockedTarget) then
            lockedTarget = findTarget()
        end
        if lockedTarget then 
            aimAt(lockedTarget)
            -- smooth ขยายวง
            local part = getTargetPart(lockedTarget.Character)
            if part then
                local dist = (part.Position - Camera.CFrame.Position).Magnitude
                local targetSize = CONFIG.CIRCLE_SIZE + math.min(dist / 50, 100)
                currentSize = currentSize + (targetSize - currentSize) * 0.2
            end
        end
    else
        lockedTarget = nil
    end

    updateLockCircle(lockedTarget)
end)

